# Environment Configuration Template
# Copy this file to .env and update with your actual values

# Database Configuration
DB_HOST=postgres
DB_NAME=emaildb
DB_USER=emailuser
DB_PASSWORD=your_secure_db_password_here

# Dovecot Configuration
USER_PASSWORD=your_test_user_password_here
DOVEADM_PASSWORD=your_doveadm_password_here

# Email Domain
DEFAULT_DOMAIN=yourdomain.com

# SSL/TLS Configuration (if using SSL)
SSL_CERT_PATH=/path/to/ssl/cert.pem
SSL_KEY_PATH=/path/to/ssl/private.key

# DKIM Configuration
DKIM_SELECTOR=default
DKIM_DOMAIN=yourdomain.com

# Mail Storage
MAIL_STORAGE_PATH=/srv/vmail
MAIL_UID=5000
MAIL_GID=5000

# Postfix Configuration
POSTFIX_HOSTNAME=mail.yourdomain.com
POSTFIX_MYDOMAIN=yourdomain.com
