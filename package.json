{
  "name": "multi-domain-email-server",
  "version": "1.0.0",
  "description": "A generic multi-domain email server with Postfix + Dovecot + Hono + TypeScript",
  "main": "src/server.ts",
  "type": "module",
  "scripts": {
    "dev": "bun run --hot src/server.ts",
    "start": "bun run src/server.ts",
    "build": "bun build src/server.ts --outdir dist --target bun",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "email",
    "postfix",
    "dovecot",
    "hono",
    "typescript",
    "multi-domain",
    "bun"
  ],
  "author": {
    "name": "rajivranjanmars",
    "url": "https://rajivranjana.in"
  },
  "license": "MIT",
  "dependencies": {
    "hono": "^4.13.13",
    "@hono/node-server": "^2.1.3",
    "nodemailer": "^10.0.14",
    "imap": "^0.8.19",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.3",
    "@types/imap": "^0.8.43",
    "@types/pg": "^8.23.1"
  },
  "contributors": [
    "Engineers Cradle"
  ],
  "overrides": {
    "semver": "^5.7.2"
  }
}
